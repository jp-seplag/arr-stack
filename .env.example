# Copie para .env e preencha:  cp .env.example .env && chmod 600 .env
PUID=1000                      # id -u
PGID=1000                      # id -g
TZ=America/Sao_Paulo
MEDIA_ROOT=/mnt/media1/media    # disco USB; ou /home/SEU_USUARIO/media no disco interno

# --- VPN (Gluetun + ProtonVPN, WireGuard) ---
# Chave gerada em account.protonvpn.com > Downloads > WireGuard configuration
# (Platform: GNU/Linux, NAT-PMP/Port Forwarding ligado, servidor P2P)
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=10.2.0.2/32
SERVER_COUNTRIES=Brazil
VPN_PORT_FORWARDING=on
PORT_FORWARD_ONLY=on
